# Variables de entorno requeridas (manifiesto: __SECRET:*__). En Vercel las
# pone el dueño del producto en el proyecto; en local/CI, copia este fichero a .env.local
# (o exporta las mismas variables) con los valores del proyecto Supabase de
# desarrollo.

# URL del proyecto Supabase y sus dos claves: la anónima (RLS por delante,
# usada por acceso/enlace mágico) y la de servicio (server-only, todo lo
# demás). Es un proyecto Supabase compartido con otros productos -el de
# desarrollo o el de producción según el entorno-, nunca un proyecto propio
# de este producto.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Esquema Postgres de este producto dentro del proyecto Supabase compartido
# (cliente-ac1/ac2). Sin ella, la fábrica de cliente (src/lib/db/cliente.ts)
# lanza en vez de caer a `public` -ese "public" es el esquema de otro
# producto en el mismo proyecto.
SUPABASE_SCHEMA=viajes_planner

# Autoriza al cron diario de Vercel a dejar constancia de vida en /api/salud
# (Authorization: Bearer <este valor>, que Vercel manda solo). No protege la
# lectura GET, que es pública a propósito.
CRON_SECRET=

# Lista blanca de correos con permiso para pedir un enlace mágico
# (acceso-ac2), separados por comas. El build falla si está vacía.
CORREOS_PERMITIDOS=
