    "prebuild": "tsx scripts/comprobar-entorno.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "verificar:esqueleto": "bash scripts/verificar-esqueleto.sh",
    "trabajador:tick": "tsx --conditions=react-server scripts/trabajador-tick.ts",
    "generar:infografia-ejemplo": "tsx --conditions=react-server scripts/generar-infografia-ejemplo.ts",
    "generar:goldens-infografia": "tsx --conditions=react-server scripts/generar-goldens-infografia.ts",
    "medir:lamina": "tsx --conditions=react-server scripts/medir-lamina.ts",
    "generar:plan-real": "tsx --conditions=react-server scripts/generar-plan-real.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/distance": "^7.4.0",
    "@vis.gl/react-maplibre": "^8.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ics": "^3.12.1",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.6",
    "opening_hours": "^3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
