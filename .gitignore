# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/
playwright-report/
artefactos/

# map-ac1: el worker de maplibre-gl se copia aquí en cada `npm install`
# (scripts/copiar-worker-maplibre.mjs) porque Turbopack no emite su fichero
# hermano maplibre-gl-shared.mjs junto al worker con `new URL(...)` -el
# propio documento de MapLibre lo marca como excepción de Next.js. Generado,
# no se versiona: viaja con la versión instalada de maplibre-gl, nunca
# suelto en el repo para no quedarse desincronizado tras un bump.
/public/maplibre/
